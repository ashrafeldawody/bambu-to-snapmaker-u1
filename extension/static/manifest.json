{
  "manifest_version": 3,
  "name": "MakerWorld to Snapmaker U1 Converter",
  "short_name": "U1 Converter",
  "version": "1.0.0",
  "description": "Adds \"Download for Snapmaker U1\" to MakerWorld. Converts Bambu 3MF projects for the Snapmaker U1, offline in your browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open the U1 Converter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "offscreen",
    "downloads"
  ],
  "host_permissions": [
    "https://makerworld.com/*",
    "https://*.makerworld.com/*",
    "https://makerworld.com.cn/*",
    "https://*.makerworld.com.cn/*",
    "https://*.bblmw.com/*",
    "https://*.bblmw.cn/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://makerworld.com/*",
        "https://makerworld.com.cn/*"
      ],
      "js": [
        "content/makerworld.js"
      ],
      "css": [
        "content/makerworld.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
